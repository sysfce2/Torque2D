<GuiWindowCtrl
    canSaveDynamicFields="false"
    Profile="GuiWindowProfile"
    HorizSizing="center"
    VertSizing="center"
    Position="439 320"
    Extent="370 310"
    Active="true"
    Text="Gui Profile Editor Sample"
    align="left"
    resizeWidth="false"
    resizeHeight="false"
    canMove="false"
    canClose="true"
    canMinimize="false"
    canMaximize="false"
    titleHeight="30"
    resizeRightWidth="10"
    resizeBottomHeight="10"
    contentProfile="GuiWindowContentProfile"
    closeButtonProfile="GuiWindowCloseButtonProfile"
    minButtonProfile="GuiWindowMinButtonProfile"
    maxButtonProfile="GuiWindowMaxButtonProfile">
    <GuiButtonCtrl
        canSaveDynamicFields="false"
        isContainer="false"
        Profile="GuiButtonProfile"
        HorizSizing="left"
        VertSizing="top"
        Position="210 230"
        Extent="140 40"
        Active="true"
        Text="Done"
        easeFillColorHL="linear"
        easeFillColorSL="linear"
        easeTimeFillColorHL="500"
        easeTimeFillColorSL="0" />
    <GuiProgressCtrl
        canSaveDynamicFields="false"
        Profile="GuiProgressProfile"
        HorizSizing="right"
        VertSizing="bottom"
        Position="10 240"
        Extent="190 20"
        Active="false"
        animationTime="250" />
    <GuiScrollCtrl
        canSaveDynamicFields="false"
        Profile="GuiScrollProfile"
        HorizSizing="fill"
        VertSizing="bottom"
        Position="0 0"
        Extent="364 220"
        Active="true"
        hScrollBar="alwaysOff"
        vScrollBar="alwaysOn"
        constantThumbHeight="false"
        scrollBarThickness="16"
        showArrowButtons="true"
        thumbProfile="GuiScrollThumbProfile"
        trackProfile="GuiScrollTrackProfile"
        arrowProfile="GuiScrollArrowProfile">
        <GuiChainCtrl
            canSaveDynamicFields="false"
            Profile="GuiChainProfile"
            HorizSizing="fill"
            VertSizing="bottom"
            Position="0 0"
            Extent="364 312"
            Active="false"
            ChildSpacing="10"
            IsVertical="true">
            <GuiControl
                canSaveDynamicFields="false"
                Profile="GuiTextProfile"
                HorizSizing="right"
                VertSizing="bottom"
                Position="10 0"
                Extent="334 108"
                Active="false"
                Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
                textWrap="true"
                textExtend="true" />
            <GuiTextEditCtrl
                canSaveDynamicFields="false"
                isContainer="false"
                Profile="GuiTextEditProfile"
                HorizSizing="center"
                VertSizing="bottom"
                Position="72 118"
                Extent="220 30"
                Active="true"
                Text="Sample..."
                align="left"
                MaxLength="1024" />
            <GuiDropDownCtrl
                canSaveDynamicFields="false"
                Profile="GuiDropDownProfile"
                HorizSizing="center"
                VertSizing="bottom"
                Position="72 158"
                Extent="220 30"
                Active="true"
                Text="none"
                easeFillColorHL="linear"
                easeFillColorSL="linear"
                easeTimeFillColorHL="500"
                easeTimeFillColorSL="0"
                ScrollProfile="GuiScrollProfile"
                thumbProfile="GuiScrollThumbProfile"
                arrowProfile="GuiScrollArrowProfile"
                trackProfile="GuiScrollTrackProfile"
                listBoxProfile="GuiListBoxProfile"
                backgroundProfile="GuiDefaultProfile" />
            <GuiControl
                canSaveDynamicFields="false"
                Profile="GuiDefaultProfile"
                HorizSizing="right"
                VertSizing="bottom"
                Position="10 198"
                Extent="334 84"
                Active="false"
                Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui."
                textWrap="true"
                textExtend="true"
                align="left" />
        </GuiChainCtrl>
    </GuiScrollCtrl>
</GuiWindowCtrl>
