<GuiSpriteCtrl
    Name="MainGameDlg"
    Profile="GuiDefaultProfile"
    HorizSizing="fill"
    VertSizing="fill"
    Position="0 0"
    Extent="1208 951"
    MinExtent="8 8"
    Active="true"
    align="default"
    vAlign="default"
    Image="@asset=Sandbox:blueGradient"
    constrainProportions="false"
    HelpTag="0">
    <GuiControl
        canSaveDynamicFields="false"
        Profile="GuiDefaultProfile"
        HorizSizing="center"
        VertSizing="anchorTop"
        Position="479 170"
        Extent="250 240"
        Active="false"
        align="default"
        vAlign="default">
        <GuiControl
            Name="UserNameTxt"
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="GuiTextProfile"
            HorizSizing="fill"
            VertSizing="anchorTop"
            Position="0 30"
            Extent="250 40"
            MinExtent="8 2"
            Active="false"
            tooltipprofile="GuiToolTipProfile"
            Text="NONAME"
            align="center"
            vAlign="default"
            fontSizeAdjust="2" />
        <GuiButtonCtrl
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="BlueButtonProfile"
            HorizSizing="center"
            VertSizing="anchorBottom"
            Position="45 110"
            Extent="160 50"
            MinExtent="8 2"
            Command="VirtualKeyboard.push(ChangeUsernameDlg, ChangeUsernameEntry);"
            Active="true"
            Text="Change User Name"
            align="default"
            vAlign="default"
            fontSizeAdjust="1.20000005"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
        <GuiButtonCtrl
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="BlueButtonProfile"
            HorizSizing="center"
            VertSizing="anchorBottom"
            Position="45 170"
            Extent="160 50"
            MinExtent="8 2"
            Command="Canvas.popDialog(MainGameDlg);"
            Active="true"
            Text="Exit"
            align="default"
            vAlign="default"
            fontSizeAdjust="1.20000005"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
    </GuiControl>
</GuiSpriteCtrl>
