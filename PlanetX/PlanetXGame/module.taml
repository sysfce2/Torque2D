<ModuleDefinition
	ModuleId="PlanetXGame"
	VersionId="1"
	BuildID="1"
	Group="launch"
	Type="Game Module"
	Description="PlanetX - a twin-stick demo game for Torque2D 4.0."
	Author=""
	ScriptFile="game.cs"
	CreateFunction="create"
	DestroyFunction="destroy"
	Dependencies="Audio=1,ScreenFade=1">
		<DeclaredAssets
			Path="sprites"
			Extension="image.taml"
			Recurse="true"/>
		<DeclaredAssets
			Path="sprites"
			Extension="animation.taml"
			Recurse="true"/>
		<DeclaredAssets
			Path="gui"
			Extension="image.taml"
			Recurse="true"/>
		<DeclaredAssets
			Path="music"
			Extension="audio.taml"
			Recurse="true"/>
		<DeclaredAssets
			Path="sound"
			Extension="audio.taml"
			Recurse="true"/>
</ModuleDefinition>
