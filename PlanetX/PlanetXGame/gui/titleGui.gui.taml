<GuiSpriteCtrl
    Name="PlanetXTitle"
    canSaveDynamicFields="false"
    Profile="PlanetXEmptyProfile"
    HorizSizing="relative"
    VertSizing="relative"
    Position="0 0"
    Extent="1024 768"
    Active="true"
    tooltipprofile="PlanetXTooltipProfile"
    Image="@asset=PlanetXGame:planetXBG"
    clampImage="false">
    <GuiControl
        Name="TitleMenu"
        canSaveDynamicFields="false"
        Profile="PlanetXEmptyProfile"
        HorizSizing="width"
        VertSizing="bottom"
        Position="0 496"
        Extent="1024 272"
        Active="false"
        tooltipprofile="PlanetXTooltipProfile">
        <GuiButtonCtrl
            Name="TitleStart1Button"
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="PlanetXButtonProfile"
            HorizSizing="center"
            VertSizing="top"
            Position="352 8"
            Extent="320 56"
            Command="PlanetXGame.playClick(); PlanetXGame.startGame(false);"
            Active="true"
            tooltipprofile="PlanetXTooltipProfile"
            Text="START 1 PLAYER"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
        <GuiButtonCtrl
            Name="TitleStart2Button"
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="PlanetXButtonProfile"
            HorizSizing="center"
            VertSizing="top"
            Position="352 74"
            Extent="320 56"
            Command="PlanetXGame.playClick(); PlanetXGame.startGame(true);"
            Active="true"
            tooltipprofile="PlanetXTooltipProfile"
            Text="START 2 PLAYERS"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
        <GuiButtonCtrl
            Name="TitleOptionsButton"
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="PlanetXButtonProfile"
            HorizSizing="center"
            VertSizing="top"
            Position="352 140"
            Extent="320 56"
            Command="PlanetXGame.playClick(); PlanetXGame.openOptions();"
            Active="true"
            tooltipprofile="PlanetXTooltipProfile"
            Text="OPTIONS"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
        <GuiButtonCtrl
            Name="TitleQuitButton"
            canSaveDynamicFields="false"
            isContainer="false"
            Profile="PlanetXButtonProfile"
            HorizSizing="center"
            VertSizing="top"
            Position="352 206"
            Extent="320 56"
            Command="PlanetXGame.playClick(); quit();"
            Active="true"
            tooltipprofile="PlanetXTooltipProfile"
            Text="QUIT"
            easeFillColorHL="linear"
            easeFillColorSL="linear"
            easeTimeFillColorHL="500"
            easeTimeFillColorSL="0" />
    </GuiControl>
    <GuiControl
        Name="TitleVersionLabel"
        canSaveDynamicFields="false"
        Profile="PlanetXEmptyProfile"
        HorizSizing="left"
        VertSizing="top"
        Position="764 728"
        Extent="240 32"
        Active="false"
        tooltipprofile="PlanetXTooltipProfile"
        align="right"
        overrideFontColor="true"
        fontColor="33 191 132 255" />
</GuiSpriteCtrl>
