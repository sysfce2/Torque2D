<GuiControl
	Name="GameOverGui"
	Profile="GuiWindowProfile"
	HorizSizing="center"
	VertSizing="center"
	Position="312 254"
	Extent="400 260">
	<GuiControl
		Name="GameOverHeading"
		Profile="GuiLabelProfile"
		HorizSizing="center"
		VertSizing="bottom"
		Position="0 36"
		Extent="400 40"
		Text="SIGNAL LOST"
		Align="center"
		OverrideFontColor="1"
		FontColor="234 72 72 255" />
	<GuiControl
		Profile="GuiTextProfile"
		HorizSizing="center"
		VertSizing="bottom"
		Position="0 84"
		Extent="400 24"
		Text="The aliens got the better of you."
		Align="center" />
	<GuiButtonCtrl
		Name="GameOverRetryButton"
		Profile="GuiButtonProfile"
		HorizSizing="center"
		VertSizing="bottom"
		Position="80 130"
		Extent="240 44"
		Text="RETRY MISSION"
		Command="PlanetXGame.playClick(); PlanetXGame.retryMission();" />
	<GuiButtonCtrl
		Name="GameOverTitleButton"
		Profile="GuiButtonProfile"
		HorizSizing="center"
		VertSizing="bottom"
		Position="80 186"
		Extent="240 44"
		Text="RETURN TO TITLE"
		Command="PlanetXGame.playClick(); PlanetXGame.dialogToTitle();" />
</GuiControl>
