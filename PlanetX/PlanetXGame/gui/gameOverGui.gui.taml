<GuiControl
    Name="gameOverGui"
    canSaveDynamicFields="false"
    Profile="PlanetXPanelProfile"
    HorizSizing="center"
    VertSizing="center"
    Position="344 331"
    Extent="560 288"
    Active="false"
    tooltipprofile="PlanetXTooltipProfile">
    <GuiControl
        Name="GameOverHeading"
        canSaveDynamicFields="false"
        Profile="PlanetXLabelProfile"
        HorizSizing="center"
        VertSizing="bottom"
        Position="-2 20"
        Extent="540 40"
        Active="false"
        tooltipprofile="PlanetXTooltipProfile"
        Text="SIGNAL LOST"
        align="center"
        fontSizeAdjust="1.5"
        overrideFontColor="true"
        fontColor="234 72 72 255" />
    <GuiControl
        canSaveDynamicFields="false"
        Profile="PlanetXLabelProfile"
        HorizSizing="center"
        VertSizing="bottom"
        Position="-2 60"
        Extent="540 30"
        Active="false"
        tooltipprofile="PlanetXTooltipProfile"
        Text="The aliens got the better of you."
        align="center" />
    <GuiButtonCtrl
        Name="GameOverRetryButton"
        canSaveDynamicFields="false"
        isContainer="false"
        Profile="PlanetXButtonProfile"
        HorizSizing="center"
        VertSizing="bottom"
        Position="128 150"
        Extent="280 50"
        Command="PlanetXGame.playClick(); PlanetXGame.retryMission();"
        Active="true"
        tooltipprofile="PlanetXTooltipProfile"
        Text="RETRY MISSION"
        easeFillColorHL="linear"
        easeFillColorSL="linear"
        easeTimeFillColorHL="500"
        easeTimeFillColorSL="0" />
    <GuiButtonCtrl
        Name="GameOverTitleButton"
        canSaveDynamicFields="false"
        isContainer="false"
        Profile="PlanetXButtonProfile"
        HorizSizing="center"
        VertSizing="bottom"
        Position="128 210"
        Extent="280 50"
        Command="PlanetXGame.playClick(); PlanetXGame.dialogToTitle();"
        Active="true"
        tooltipprofile="PlanetXTooltipProfile"
        Text="RETURN TO TITLE"
        easeFillColorHL="linear"
        easeFillColorSL="linear"
        easeTimeFillColorHL="500"
        easeTimeFillColorSL="0" />
</GuiControl>
